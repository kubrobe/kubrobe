---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import Intro from '@/components/home/Intro.astro';
import FeaturedWork from '@/components/home/FeaturedWork.astro';
import CertPreview from '@/components/home/CertPreview.astro';
import WritingPreview from '@/components/home/WritingPreview.astro';
import AboutPreview from '@/components/home/AboutPreview.astro';
import { profile } from '@/data/profile';
import { getWork, getWriting, getCertifications, getLastUpdated } from '@/lib/entries';

const [work, writing, certs, updated] = await Promise.all([getWork(), getWriting(), getCertifications(), getLastUpdated()]);
const featured = (work.some((w) => w.data.featured) ? work.filter((w) => w.data.featured) : work).slice(0, 6);
const latest = writing.slice(0, 3);
const hasIntro = Boolean(profile.statement || profile.role || profile.currently || profile.openTo);
const hasAbout = Boolean(profile.about.length || profile.now.length || profile.interests.length);
const total = work.length + writing.length + certs.length;

// "Enter the index" points at the first section that actually renders.
const next = [
  hasIntro && '#intro',
  featured.length && '#work',
  certs.length && '#credentials',
  latest.length && '#writing',
  hasAbout && '#about',
].find(Boolean) || undefined;
---
<Base>
  <Hero entries={total} updated={updated} next={next} />
  <Intro />
  {featured.length > 0 && <FeaturedWork featured={featured} total={work.length} />}
  {certs.length > 0 && <CertPreview certs={certs} />}
  {latest.length > 0 && <WritingPreview posts={latest} />}
  {hasAbout && <AboutPreview />}
</Base>
