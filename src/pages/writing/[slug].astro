---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import { getWriting, isoDate, readingMinutes } from '@/lib/entries';

export const getStaticPaths = (async () => (await getWriting()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.description} type="article">
  <PageHead number={d.number} label="Note" title={d.title} lede={d.description}>
    <p class="kb-meta mt-6 flex flex-wrap gap-x-5 text-ink-2">
      <time datetime={isoDate(d.date)}>{isoDate(d.date)}</time>
      {d.updated && <span>Updated <time datetime={isoDate(d.updated)}>{isoDate(d.updated)}</time></span>}
      <span>{readingMinutes(entry.body)} min read</span>
      {d.placeholder && <span class="kb-ph-tag">Placeholder</span>}
    </p>
  </PageHead>
  <div class="kb-wrap pb-20"><div class="kb-grid"><article class="kb-main kb-prose"><Content /></article></div></div>
</Base>
