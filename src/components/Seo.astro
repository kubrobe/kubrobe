---
import { profile } from '@/data/profile';
import { site as meta, contact } from '@/data/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean | undefined;
  type?: 'website' | 'article' | undefined;
}
const SITE = meta.brand;
// Plain-text version of the approved statement and introduction; never invent a tagline.
const fallback = [profile.statement.replaceAll('*', ''), profile.intro].join(' ');
const isHome = Astro.url.pathname === '/';
const isAbout = /^\/about\/?$/.test(Astro.url.pathname);
const isContact = /^\/contact\/?$/.test(Astro.url.pathname);
// Person data: verified, approved facts only (no birth date, so no age field).
const person = (origin: URL) => ({
  '@type': 'Person',
  '@id': new URL('/#person', origin).href,
  name: profile.name,
  givenName: profile.givenName,
  familyName: profile.familyName,
  alternateName: profile.brand,
  url: new URL('/', origin).href,
  ...(contact.email ? { email: `mailto:${contact.email}` } : {}),
  ...(contact.phone ? { telephone: contact.phone } : {}),
  sameAs: contact.sameAs,
  homeLocation: { '@type': 'Place', name: `${profile.location.hometown}, ${profile.location.region}, ${profile.location.country}` },
  affiliation: { '@type': 'CollegeOrUniversity', name: profile.education.institution },
  knowsAbout: profile.interests.flatMap((g) => g.items.map((i) => i.title)),
});
const ld = (origin: URL) => isAbout || isContact
  ? { '@context': 'https://schema.org', '@type': isAbout ? 'ProfilePage' : 'ContactPage', url: new URL(Astro.url.pathname, origin).href, mainEntity: person(origin) }
  : { '@context': 'https://schema.org', '@graph': [
      { '@type': 'WebSite', '@id': new URL('/#website', origin).href, name: SITE, url: new URL('/', origin).href, description, author: { '@id': new URL('/#person', origin).href } },
      person(origin),
    ] };
const { title, description = (isHome ? meta.homeDescription : fallback) || SITE, noindex = false, type = 'website' } = Astro.props;
// The home page carries the brand and the owner's name; other pages are "Page · KUBROBE".
const fullTitle = title ? `${title} · ${SITE}` : meta.homeTitle;

// Canonical, og:url and og:image use the configured site origin (https://www.kubrobe.uz by default).
const site = Astro.site;
const hasDomain = Boolean(site && !['localhost', '127.0.0.1'].includes(site.hostname));
const canonical = hasDomain && site ? new URL(Astro.url.pathname, site) : undefined;
const image = hasDomain && site ? new URL('/og.png', site) : undefined;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && !noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:site_name" content={SITE} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en" />
{canonical && <meta property="og:url" content={canonical} />}
{image && !noindex && <meta property="og:image" content={image} />}
{image && !noindex && <meta property="og:image:width" content="1200" />}
{image && !noindex && <meta property="og:image:height" content="630" />}
{image && !noindex && <meta property="og:image:alt" content={meta.ogImageAlt} />}
<meta name="twitter:card" content={image && !noindex ? 'summary_large_image' : 'summary'} />
{canonical && !noindex && site && (isHome || isAbout || isContact) && (
  <script type="application/ld+json" set:html={JSON.stringify(ld(site))} />
)}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{image && !noindex && <meta name="twitter:image" content={image} />}
