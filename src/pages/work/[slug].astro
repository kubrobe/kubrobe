---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import StatusGlyph from '@/components/StatusGlyph.astro';
import { getWork, workTypeLabel, code } from '@/lib/entries';

export const getStaticPaths = (async () => (await getWork()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const spec = [
  ['Entry', code(d.number)],
  ['Type', workTypeLabel[d.type]],
  ['Year', String(d.year)],
  ['Role', d.role],
  ['Timeline', d.timeline],
  ['Stack', d.stack.join(', ') || undefined],
].filter((r): r is [string, string] => Boolean(r[1]));
---
<Base title={d.title} description={d.summary} type="article">
  <PageHead number={d.number} label={workTypeLabel[d.type]} title={d.title} lede={d.summary}>
    {d.placeholder && <span class="kb-ph-tag mt-4 inline-block">Placeholder</span>}
  </PageHead>
  <div class="kb-wrap pb-20">
    <div class="kb-grid">
      <aside class="kb-rail kb-meta min-[900px]:sticky min-[900px]:top-[calc(var(--kb-bar-h)+24px)] min-[900px]:self-start" aria-label="Spec sheet">
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 border-t border-rule pt-3 min-[900px]:grid-cols-1">
          {spec.map(([k, v]) => <><dt class="text-ink-3">{k}</dt><dd class="mb-2 text-ink-2">{v}</dd></>)}
          <dt class="text-ink-3">Status</dt><dd><StatusGlyph kind="work" status={d.status} /></dd>
        </dl>
        {d.links.length > 0 && <ul class="mt-4 grid gap-1">{d.links.map((l) => <li><a class="kb-link" href={l.href}>{l.label} ↗</a></li>)}</ul>}
      </aside>
      <article class="kb-main kb-prose mt-8 min-[900px]:mt-0"><Content /></article>
    </div>
  </div>
</Base>
