---
import ThemeToggle from './ThemeToggle.astro';
import { pad } from '@/lib/entries';
import type { NavItem } from '@/lib/nav';
interface Props { nav: NavItem[] }
const { nav } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href) || path === href.replace(/\/$/, '');
---
<header class="kb-header sticky top-0 z-50 border-b border-rule bg-surface pt-[env(safe-area-inset-top)]">
  <div class="kb-wrap flex h-[var(--kb-bar-h)] items-center gap-6">
    <a href="/" class="kb-meta inline-flex min-h-11 min-w-11 items-center font-semibold tracking-[0.06em] text-ink no-underline" aria-label="KUBROBE, home"><span class="kb-home-k">KB</span><span class="kb-home-name hidden text-ink-2 xl:inline">&nbsp;· Najmiddin Kurganov</span></a>
    {nav.length > 0 && (
      <nav aria-label="Primary" class="mx-auto hidden lg:block">
        <ul class="flex items-baseline gap-7 text-sm">
          {nav.map((n) => (
            <li>
              <a
                href={n.href}
                class:list={['relative inline-flex min-h-11 items-center hover:text-ink', isActive(n.href) ? 'text-ink' : 'kb-draw-nav text-ink-2']}
                aria-current={isActive(n.href) ? 'page' : undefined}
              >
                {isActive(n.href) && <span class="kb-nav-ind absolute inset-x-0 bottom-2 h-0.5 bg-jade" aria-hidden="true" />}
                {n.label}{n.count !== undefined && <sup class="kb-meta ml-0.5 text-[0.65rem] text-ink-3" aria-hidden="true">{pad(n.count)}</sup><span class="sr-only">, {n.count} entries</span>}
              </a>
            </li>
          ))}
          <li><a href="#contact" class="kb-draw-nav relative inline-flex min-h-11 items-center text-ink-2 hover:text-ink">Contact</a></li>
        </ul>
      </nav>
    )}
    <ThemeToggle class="ml-auto lg:ml-0" />
  </div>
</header>
<style>
  .kb-header { view-transition-name: kb-header; }
  /* Active underline travels between items across page loads (cross-document view transition). */
  .kb-nav-ind { view-transition-name: kb-nav-ind; }
  .kb-draw-nav::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 10px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--kb-dur-ui) var(--kb-ease-out);
  }
  .kb-draw-nav:hover::after, .kb-draw-nav:focus-visible::after { transform: scaleX(1); transform-origin: left; }
</style>
