---
import NowList from '@/components/profile/NowList.astro';
import Interests from '@/components/profile/Interests.astro';
/** Closing section before contact: what is happening now, and the interests behind it. */
---
<section id="now" class="kb-wrap kb-section kb-rule" aria-labelledby="now-h">
  <div class="kb-grid gap-y-12">
    <div class="kb-rail kb-meta flex gap-3 text-ink-2 lg:sticky lg:top-[calc(var(--kb-bar-h)+28px)] lg:block lg:self-start lg:pt-3">
      <span class="text-ink lg:block">04</span><span>Now</span>
    </div>
    <div class="kb-main grid min-w-0 gap-[var(--kb-space-block)]">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,5fr)] lg:gap-x-[var(--kb-gutter)]">
        <h2 id="now-h" data-reveal="mask" class="text-h2 font-[560] leading-[0.98] tracking-[-0.035em]">Currently <em class="kb-em">working on</em></h2>
        <NowList />
      </div>
      <div class="grid gap-6">
        <h3 class="kb-label">Interests</h3>
        <Interests level={4} />
      </div>
    </div>
  </div>
</section>
