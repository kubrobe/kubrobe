---
/**
 * KUBROBE set full width: the site's one full-bleed typographic moment.
 * Intro: letters rise through a mask, from the O outward (CSS only, see motion.css).
 * Scroll: the weight eases from 640 to 440 as the wordmark leaves (--kb-wm-w, CSS scroll timeline).
 * Desktop with a fine pointer: letter weight follows the pointer (small rAF script).
 * Both are off under prefers-reduced-motion.
 */
const letters = ['K', 'U', 'B', 'R', 'O', 'B', 'E'];
---
<h1 id="kb-wordmark" class="kb-wordmark select-none" data-wordmark>
  <span class="sr-only">KUBROBE</span>
  <span aria-hidden="true" class="flex">
    {letters.map((l, i) => (
      <span class="kb-wm-mask"><span class="kb-wm-l" style={`--d:${Math.abs(i - 4)}`} data-o={i === 4 ? '' : undefined}>{l}</span></span>
    ))}
  </span>
</h1>
<style>
  .kb-wordmark {
    /* Fitted to the content width: 7 letters of Geist 640 at -5.5% ≈ 4.43em. */
    font-size: calc((min(100vw, 1680px) - 2 * var(--kb-margin)) / 4.43);
    font-weight: 640;
    letter-spacing: -0.055em;
    line-height: 0.8;
    margin-left: -0.045em;
    white-space: nowrap;
  }
  .kb-wm-mask { display: block; overflow: clip; padding-block: 0.03em 0.02em; }
  .kb-wm-l {
    display: block;
    font-variation-settings: 'wght' var(--w, var(--kb-wm-w));
    transition: font-variation-settings var(--kb-dur-micro) var(--kb-ease-out);
  }
</style>
<script>
  const wm = document.querySelector<HTMLElement>('[data-wordmark]');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wm && fine && !calm) {
    const letters = [...wm.querySelectorAll<HTMLElement>('.kb-wm-l')];
    let raf = 0;
    let x = 0;
    const paint = () => {
      raf = 0;
      for (const l of letters) {
        const r = l.getBoundingClientRect();
        const dist = Math.abs(x - (r.left + r.width / 2)) / window.innerWidth;
        const w = Math.round(820 - Math.min(dist * 2.2, 1) * 260);
        l.style.setProperty('--w', String(w));
      }
    };
    wm.addEventListener('pointermove', (e) => { x = e.clientX; if (!raf) raf = requestAnimationFrame(paint); });
    wm.addEventListener('pointerleave', () => { cancelAnimationFrame(raf); raf = 0; letters.forEach((l) => l.style.removeProperty('--w')); });
  }
</script>
