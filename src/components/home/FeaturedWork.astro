---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '@/components/Section.astro';
import StatusGlyph from '@/components/StatusGlyph.astro';
import { workTypeLabel, pad, code } from '@/lib/entries';
interface Props { featured: CollectionEntry<'work'>[]; total: number }
const { featured, total } = Astro.props;
---
<Section marker="03" label="Selected work" id="work" heading="Selected *work*">
  <!--
    Each project is one link: name, what it is, my part, its stack, and three of its real screens
    set side by side like a contact sheet. Everything that matters is visible without hover.
  -->
  <ol class="kb-ix">
    {featured.map((w, i) => {
      const d = w.data;
      const shots = d.gallery.slice(0, 3);
      return (
        <li class="kb-ix-li">
          <a href={`/work/${w.id}/`} class="kb-ix-a group" aria-describedby={`kb-ix-${d.number}-d`}>
            <span class="kb-ix-n kb-meta"><span class="text-ink">{pad(i + 1)}</span><span class="kb-ix-code">{code(d.number)}</span></span>
            <span class="kb-ix-body">
              <span data-reveal="mask" class="block">
                <span class="kb-ix-title" style={`view-transition-name:kb-t-${d.number};view-transition-class:kb-title`}>{d.title}</span>
              </span>
              {d.placeholder && <span class="kb-ph-tag w-fit">Placeholder</span>}
              <span id={`kb-ix-${d.number}-d`} class="kb-ix-sum" data-reveal>{d.summary}</span>
              <span class="kb-ix-meta kb-meta" data-reveal>
                <span class="kb-ix-kv"><span class="kb-ix-k">Type</span>{workTypeLabel[d.type]} · {d.year}</span>
                <span class="kb-ix-kv"><span class="kb-ix-k">Status</span><StatusGlyph kind="work" status={d.status} /></span>
                {d.role && <span class="kb-ix-kv kb-ix-wide"><span class="kb-ix-k">Role</span>{d.role}</span>}
                {d.stack.length > 0 && <span class="kb-ix-kv kb-ix-wide"><span class="kb-ix-k">Stack</span>{d.stack.slice(0, 4).join(' · ')}{d.stack.length > 4 && ` +${d.stack.length - 4}`}</span>}
              </span>
              <span class="kb-ix-cta kb-meta">Read the case study <span class="kb-arrow" data-dir="e" aria-hidden="true">→</span></span>
            </span>
            {shots.length > 0 && (
              <span class="kb-ix-sheet" aria-hidden="true">
                {shots.map((g, j) => (
                  <span class="kb-ix-shot" style={`--j:${j}`}>
                    <Image src={g.src} alt="" widths={[160, 240, 360]} sizes="(min-width: 60rem) 8rem, 30vw" loading="lazy" decoding="async" />
                  </span>
                ))}
              </span>
            )}
          </a>
        </li>
      );
    })}
  </ol>
  {total > featured.length && (
    <a href="/work/" class="kb-draw kb-meta mt-8 inline-flex min-h-11 items-center text-ink-2 hover:text-ink">All {pad(total)} entries →</a>
  )}
</Section>
<style>
  .kb-ix { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--kb-rule); }
  .kb-ix-li { border-bottom: 1px solid var(--kb-rule); }
  .kb-ix-a {
    position: relative; display: grid; gap: 16px 24px; text-decoration: none; color: inherit;
    grid-template-columns: minmax(0, 1fr); grid-template-areas: 'n' 'body' 'sheet';
    padding: 24px 0 32px;
  }
  .kb-ix-n { grid-area: n; display: flex; gap: 14px; color: var(--kb-ink-3); }
  .kb-ix-body { grid-area: body; display: grid; gap: 16px; align-content: start; min-width: 0; }
  .kb-ix-title {
    display: inline-block; font-size: clamp(2.75rem, 1.4rem + 5.6vw, 6rem); line-height: 0.94; font-weight: 560; letter-spacing: -0.045em;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 2px; padding-bottom: 0.08em;
    transition: transform var(--kb-dur-ui) var(--kb-ease-out), background-size var(--kb-dur-ui) var(--kb-ease-mask);
  }
  .kb-ix-sum { max-width: 46ch; font-size: var(--text-lg); line-height: 1.5; color: var(--kb-ink-2); text-wrap: pretty; transition: color var(--kb-dur-micro) var(--kb-ease-out); }
  .kb-ix-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px; max-width: 46rem; border-top: 1px solid var(--kb-rule); padding-top: 12px; color: var(--kb-ink-2); }
  .kb-ix-kv { display: grid; gap: 2px; min-width: 0; }
  .kb-ix-wide { grid-column: 1 / -1; }
  .kb-ix-k { color: var(--kb-ink-3); font-size: 0.75rem; letter-spacing: 0.07em; text-transform: uppercase; }
  .kb-ix-cta { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; width: fit-content; color: var(--kb-ink); }

  /* Contact sheet: three real screens, shown whole on desktop and cropped from the top on phones. */
  .kb-ix-sheet { grid-area: sheet; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; align-self: start; }
  .kb-ix-shot { display: block; aspect-ratio: 9 / 16; overflow: clip; background: var(--kb-raised); border: 1px solid var(--kb-rule); }
  .kb-ix-shot :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: top;
    filter: grayscale(0.35) brightness(0.86);
    transition: filter var(--kb-dur-ui) var(--kb-ease-out), transform 640ms var(--kb-ease-out);
    transition-delay: calc(var(--j) * 50ms);
  }
  .kb-ix-shot { transition: transform var(--kb-dur-ui) var(--kb-ease-out), border-color var(--kb-dur-ui) var(--kb-ease-out); transition-delay: calc(var(--j) * 50ms); }
  .kb-ix-a:focus-visible { outline: 2px solid var(--kb-jade); outline-offset: 6px; }

  @media (min-width: 48rem) {
    .kb-ix-a { grid-template-columns: 6rem minmax(0, 1fr); grid-template-areas: 'n body' '. sheet'; }
    .kb-ix-n { flex-direction: column; gap: 2px; padding-top: 0.9rem; }
    .kb-ix-sheet { max-width: 30rem; }
  }
  @media (min-width: 60rem) {
    .kb-ix-a { grid-template-columns: 6rem minmax(0, 1fr) minmax(20rem, 28rem); grid-template-areas: 'n body sheet'; padding: 56px 0 64px; gap: 0 clamp(24px, 3vw, 56px); }
    /* Alternate the composition, so consecutive projects read as separate plates rather than a list. */
    .kb-ix-li:nth-child(even) .kb-ix-a { grid-template-columns: minmax(20rem, 28rem) minmax(0, 1fr) 6rem; grid-template-areas: 'sheet body n'; }
    .kb-ix-li:nth-child(even) .kb-ix-n { align-items: flex-end; text-align: right; }
    .kb-ix-shot { aspect-ratio: 9 / 19.5; }
    .kb-ix-shot:nth-child(2) { margin-top: 28px; }
    .kb-ix-sheet { max-width: none; }
  }

  @media (hover: hover) {
    .kb-ix-a:hover .kb-ix-title { transform: translateX(10px); background-size: 100% 2px; }
    .kb-ix-a:hover .kb-ix-sum { color: var(--kb-ink); }
    .kb-ix-a:hover .kb-ix-shot { transform: translateY(-6px); border-color: var(--kb-rule-2); }
    .kb-ix-a:hover .kb-ix-shot :global(img) { filter: none; transform: scale(1.035); }
    .kb-ix-a:hover .kb-ix-cta .kb-arrow { transform: translateX(4px); color: var(--kb-jade); }
  }
  .kb-ix-a:focus-visible .kb-ix-title { transform: translateX(10px); background-size: 100% 2px; }
  .kb-ix-a:focus-visible .kb-ix-sum { color: var(--kb-ink); }
  .kb-ix-a:focus-visible .kb-ix-shot :global(img) { filter: none; }
  @media (prefers-reduced-motion: reduce) { .kb-ix-title, .kb-ix-shot, .kb-ix-shot :global(img) { transition: none; } }
</style>
