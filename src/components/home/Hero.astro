---
import Wordmark from '@/components/Wordmark.astro';
import { profile, profileIsPlaceholder } from '@/data/profile';
import { code, isoDate, pad } from '@/lib/entries';
import { emphasize } from '@/lib/text';
import type { NavItem } from '@/lib/nav';
import pkg from '../../../package.json';

interface Props { entries: number; updated?: Date | undefined; nav: NavItem[]; hasContact: boolean }
const { entries, updated, nav, hasContact } = Astro.props;
const clock = profile.showLocalTime && profile.timeZone ? profile.timeZone : undefined;
// Hero navigation: only destinations that exist, with real counts.
const links = [
  ...nav.map((n) => ({ href: n.href, label: n.label, count: n.count })),
  ...(hasContact ? [{ href: '#contact', label: 'Contact', count: undefined }] : []),
];
---
<section class="kb-hero kb-wrap flex flex-col pt-5 pb-10 lg:pt-8 lg:pb-14" aria-labelledby="kb-wordmark">
  <div class="kb-grid kb-meta kb-in text-ink-2" style="--i:0">
    <div class="kb-rail hidden lg:block"><span class="block text-ink">{code(0)}</span>Index</div>
    <p class="kb-main flex flex-wrap justify-between gap-x-6 gap-y-1 border-t border-rule pt-2">
      {profile.city && (
        <span>{profile.city}{clock && <> · <time data-clock={clock}>--:--</time> local</>}</span>
      )}
      {entries > 0 && <span>Entries {pad(entries, 3)}</span>}
      {updated && <span>Updated <time datetime={isoDate(updated)}>{isoDate(updated)}</time></span>}
      <span>v{pkg.version}</span>
    </p>
  </div>

  <div class="mt-auto pt-[clamp(72px,20vw,120px)] lg:pt-16">
    <Wordmark />
  </div>

  {(profile.statement || links.length > 0) && (
  <div class="kb-grid mt-[clamp(28px,4vw,56px)] gap-y-10 border-t border-rule pt-5 lg:pt-6">
    <div class="kb-rail kb-meta kb-in hidden text-ink-2 lg:block" style="--i:6">
      <span class="block text-ink">{code(1)}</span>{profile.statement ? 'Statement' : 'Contents'}
    </div>
    {profile.statement && (
      <p class:list={['kb-in min-w-0 text-[clamp(1.75rem,1.15rem+2.5vw,3.5rem)] leading-[1.06] font-[460] tracking-[-0.03em] text-balance md:col-span-6 lg:col-[3/9]', profileIsPlaceholder('statement') && 'text-ink-2']} style="--i:7">
        <Fragment set:html={emphasize(profile.statement)} />
      </p>
    )}
    {links.length > 0 && (
      <nav aria-label="Contents" class:list={['kb-in md:col-span-6', profile.statement ? 'lg:col-[10/13] lg:self-end' : 'lg:col-[3/13]']} style="--i:8">
        <ol class:list={['border-b border-rule', !profile.statement && 'lg:grid lg:grid-cols-5 lg:gap-x-[var(--kb-gutter)] lg:border-b-0', 'md:max-lg:grid md:max-lg:grid-cols-2 md:max-lg:gap-x-[var(--kb-gutter)] md:max-lg:border-t md:max-lg:border-b-0']}>
          {links.map((l, i) => (
            <li class="border-t border-rule md:max-lg:border-t-0 md:max-lg:border-b">
              <a href={l.href} class="kb-hero-link group flex min-h-11 items-baseline justify-between gap-4 py-2 no-underline">
                <span class="flex items-baseline gap-3">
                  <span class="kb-meta text-ink-3">{pad(i + 1)}</span>
                  <span class="kb-hero-label text-lg">{l.label}</span>
                </span>
                <span class="kb-meta text-ink-2">
                  {l.count !== undefined && <span>{pad(l.count)} <span class="sr-only">entries</span></span>}
                  <span aria-hidden="true" class="kb-hero-arrow ml-2 inline-block">→</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
  )}
</section>
<style>
  /* The hero fills the first screen on tablets and up so the wordmark lands on the fold. */
  @media (min-width: 60rem) and (min-height: 600px) {
    .kb-hero { min-height: calc(100svh - var(--kb-bar-h) - var(--kb-mobile-bar-h) - env(safe-area-inset-top)); }
  }
  .kb-hero-label, .kb-hero-arrow { transition: transform var(--kb-dur-ui) var(--kb-ease-out); }
  .kb-hero-link:focus-visible { outline-offset: -2px; }
  @media (hover: hover) {
    .kb-hero-link:hover .kb-hero-label { transform: translateX(8px); }
    .kb-hero-link:hover .kb-hero-arrow { transform: translateX(4px); }
  }
  .kb-hero-link:focus-visible .kb-hero-label { transform: translateX(8px); }

  /* Staggered entrance after the wordmark. Without motion (or without support) everything is simply visible. */
  @media (prefers-reduced-motion: no-preference) {
    .kb-in { animation: kb-hero-in 700ms var(--kb-ease-out) both; animation-delay: calc(var(--i) * 90ms); }
    @keyframes kb-hero-in { from { opacity: 0; transform: translateY(14px); } }
  }
</style>
{clock && (
  <script>
    document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((el) => {
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: el.dataset['clock'] });
      const tick = () => { el.textContent = fmt.format(new Date()); };
      tick();
      setInterval(tick, 30_000);
    });
  </script>
)}
