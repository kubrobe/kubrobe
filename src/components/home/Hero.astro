---
import Wordmark from '@/components/Wordmark.astro';
import { profile, yearLabel } from '@/data/profile';
import { pad } from '@/lib/entries';
import { revealWords } from '@/lib/text';
import type { NavItem } from '@/lib/nav';

interface Props { entries: number; nav: NavItem[]; hasContact: boolean }
const { entries, nav, hasContact } = Astro.props;
const clock = profile.showLocalTime && profile.timeZone ? profile.timeZone : undefined;
const study = [profile.education.major, yearLabel(profile.education.year)].filter(Boolean).join(' · ');
// Hero navigation: only destinations that exist, with real counts.
const links = [
  ...nav.map((n) => ({ href: n.href, label: n.label, count: n.count })),
  ...(hasContact ? [{ href: '#contact', label: 'Contact', count: undefined }] : []),
];
---
<section class="kb-hero kb-wrap flex flex-col pt-5 pb-10 lg:pt-8 lg:pb-14" aria-labelledby="kb-wordmark">
  <div class="kb-grid kb-meta kb-in text-ink-2" style="--i:0">
    <div class="kb-rail hidden lg:block"><span class="block text-ink">Index</span>{profile.brand}</div>
    <p class="kb-main kb-draw-in grid grid-cols-2 gap-x-6 gap-y-1 pt-2 md:flex md:flex-wrap md:justify-between" style="--i:0">
      <span class="col-span-2 text-ink md:col-span-1">{profile.name}</span>
      <span class="col-span-2 md:col-span-1">{profile.location.display}{clock && <> · <time data-clock={clock}>--:--</time></>}</span>
      {study && <span class="whitespace-nowrap">{study}</span>}
      {entries > 0 && <span class="whitespace-nowrap text-right md:text-left">Entries {pad(entries, 3)}</span>}
    </p>
  </div>

  <div class="mt-auto pt-[clamp(64px,18vw,120px)] lg:pt-16">
    <Wordmark />
  </div>

  <div class="kb-grid kb-draw-in mt-[clamp(24px,4vw,56px)] gap-y-10 pt-5 lg:pt-6" style="--i:4">
    <div class="kb-rail kb-meta kb-in hidden text-ink-2 lg:block" style="--i:6">
      <span class="block text-ink">01</span>Statement
    </div>
    <div class="kb-in grid min-w-0 content-start gap-5 md:col-span-6 lg:col-[3/10]" style="--i:7">
      <p class="kb-statement text-balance">
        <Fragment set:html={revealWords(profile.statement)} />
      </p>
      <p class="kb-meta max-w-[46ch] text-ink-2">
        <span class="text-ink">{profile.name}</span>, {profile.education.major} student at {profile.education.institution}.
      </p>
    </div>
    {links.length > 0 && (
      <nav aria-label="Contents" class="kb-in md:col-span-6 lg:col-[10/13] lg:self-end" style="--i:8">
        <ol class="border-b border-rule md:max-lg:grid md:max-lg:grid-cols-3 md:max-lg:gap-x-[var(--kb-gutter)] md:max-lg:border-t md:max-lg:border-b-0">
          {links.map((l, i) => (
            <li class="border-t border-rule md:max-lg:border-t-0 md:max-lg:border-b">
              <a href={l.href} class="kb-hero-link group flex min-h-12 items-center justify-between gap-4 py-2 no-underline">
                <span class="flex items-baseline gap-3">
                  <span class="kb-meta text-ink-3 transition-colors duration-[var(--kb-dur-micro)] group-hover:text-jade group-focus-visible:text-jade">{pad(i + 1)}</span>
                  <span class="kb-hero-label text-lg">{l.label}</span>
                </span>
                <span class="kb-meta text-ink-2">
                  {l.count !== undefined && <span>{pad(l.count)} <span class="sr-only">entries</span></span>}
                  <span aria-hidden="true" class="kb-hero-arrow ml-2 inline-block">{l.href.startsWith('#') ? '↓' : '→'}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</section>
<style>
  /* The hero fills the first screen on tablets and up so the wordmark lands on the fold. */
  @media (min-width: 60rem) and (min-height: 600px) {
    .kb-hero { min-height: calc(100svh - var(--kb-bar-h) - var(--kb-mobile-bar-h) - env(safe-area-inset-top)); }
  }
  .kb-statement {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 4.25rem);
    line-height: 1.02;
    font-weight: 480;
    letter-spacing: -0.035em;
  }
  .kb-hero-label, .kb-hero-arrow { transition: transform var(--kb-dur-ui) var(--kb-ease-out); }
  .kb-hero-link:focus-visible { outline-offset: -2px; }
  @media (hover: hover) {
    .kb-hero-link:hover .kb-hero-label { transform: translateX(8px); }
    .kb-hero-link:hover .kb-hero-arrow { transform: translateX(4px); }
    .kb-hero-link[href^='#']:hover .kb-hero-arrow { transform: translateY(3px); }
  }
  .kb-hero-link:focus-visible .kb-hero-label { transform: translateX(8px); }
</style>
