---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { pad } from '@/lib/entries';

interface Props {
  id: string;
  shot: { src: ImageMetadata; alt: string; caption?: string | undefined };
  index: number;
  total: number;
  prevId: string;
  nextId: string;
}
const { id, shot, index, total, prevId, nextId } = Astro.props;
---
<!--
  One enlarged screen in a native popover. Close, Esc and click-outside are native.
  The script below adds previous/next (buttons, arrow keys, swipe) and focus handling; the step
  buttons stay hidden without it. They cannot be popover targets: a target whose invoker sits inside
  an open popover opens as a nested popover instead of replacing it.
-->
<div popover="auto" id={id} class="kb-lightbox" role="dialog" aria-label={`${shot.caption ?? 'Screen'}, ${index + 1} of ${total}`} data-prev={prevId} data-next={nextId}>
  <Image src={shot.src} alt={shot.alt} widths={[480, 900]} sizes="(min-width: 48rem) 450px, 90vw" loading="lazy" class="kb-lightbox-img block h-auto max-h-[72vh] w-auto max-w-full object-contain" />
  <div class="kb-meta mt-3 grid gap-3 text-ink-2">
    <div class="grid gap-1">
      {shot.caption && <p class="text-ink">{shot.caption}</p>}
      <p class="max-w-[46ch] text-ink-3" aria-hidden="true">{shot.alt}</p>
    </div>
    <div class="flex items-center justify-between gap-3">
      <span aria-hidden="true">{pad(index + 1)} / {pad(total)}</span>
      <span class="flex gap-2">
        {total > 1 && <button type="button" class="kb-btn" data-step="prev" hidden aria-label="Previous screen">←</button>}
        {total > 1 && <button type="button" class="kb-btn" data-step="next" hidden aria-label="Next screen">→</button>}
        <button type="button" class="kb-btn kb-lightbox-close" popovertarget={id} popovertargetaction="hide">Close</button>
      </span>
    </div>
  </div>
</div>
<script>
  // Arrow keys and swipe step between screens; focus stays inside the viewer and returns to where it started.
  let origin: HTMLElement | null = null;
  const open = () => document.querySelector<HTMLElement>('.kb-lightbox:popover-open');
  const step = (from: HTMLElement, dir: 'prev' | 'next') => {
    const id = from.dataset[dir];
    const to = id ? document.getElementById(id) : null;
    if (to && to !== from) to.showPopover();
  };
  document.addEventListener('beforetoggle', (e) => {
    const t = e.target as HTMLElement;
    if (!t.classList?.contains('kb-lightbox') || (e as ToggleEvent).newState !== 'open') return;
    if (!open() && document.activeElement instanceof HTMLElement) origin = document.activeElement;
  }, true);
  document.addEventListener('toggle', (e) => {
    const t = e.target as HTMLElement;
    if (!t.classList?.contains('kb-lightbox')) return;
    if ((e as ToggleEvent).newState === 'open') t.querySelector<HTMLElement>('.kb-lightbox-close')?.focus({ preventScroll: true });
    else queueMicrotask(() => { if (!open() && origin?.isConnected) { origin.focus({ preventScroll: true }); origin = null; } });
  }, true);
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest?.<HTMLElement>('[data-step]');
    const lb = b?.closest<HTMLElement>('.kb-lightbox');
    if (b && lb) step(lb, b.dataset['step'] === 'prev' ? 'prev' : 'next');
  });
  document.querySelectorAll<HTMLElement>('.kb-lightbox [data-step]').forEach((b) => b.removeAttribute('hidden'));
  document.addEventListener('keydown', (e) => {
    const lb = open();
    if (!lb || e.altKey || e.ctrlKey || e.metaKey) return;
    if (e.key === 'ArrowRight') { e.preventDefault(); step(lb, 'next'); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); step(lb, 'prev'); }
  });
  let x0 = 0;
  document.addEventListener('pointerdown', (e) => { if ((e.target as HTMLElement).closest?.('.kb-lightbox-img')) x0 = e.clientX; else x0 = 0; });
  document.addEventListener('pointerup', (e) => {
    const lb = open(); if (!lb || !x0) return;
    const dx = e.clientX - x0; x0 = 0;
    if (Math.abs(dx) > 48) step(lb, dx < 0 ? 'next' : 'prev');
  });
</script>
