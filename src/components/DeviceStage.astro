---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from '@/components/Lightbox.astro';
import { pad } from '@/lib/entries';

interface Shot { src: ImageMetadata; alt: string; caption?: string | undefined }
interface Props { shots: Shot[]; source?: string | undefined; id: string }
const { shots, source, id } = Astro.props;
const n = shots.length;
---
<!--
  Framed phones in a row. The selected screen sits in front; the others sit behind it, smaller and dimmed.
  The state is a set of radio buttons, so it works without JavaScript: arrow keys move between screens,
  tapping a thumbnail or a screen behind selects it. Position maths is CSS custom properties.
-->
<section class="kb-stage" aria-labelledby={`${id}-h`} style={`--count:${n}`}>
  <div class="mb-4 flex items-baseline justify-between gap-4">
    <h2 id={`${id}-h`} class="kb-label">Screens</h2>
    <p class="kb-meta text-ink-3">{n} screens · choose one, then enlarge</p>
  </div>

  {shots.map((_, i) => <input type="radio" name={`${id}-sel`} id={`${id}-r${i}`} class="kb-stage-r sr-only" checked={i === 0} aria-label={shots[i]?.caption ?? `Screen ${i + 1}`} />)}

  <div class="kb-stage-view" data-reveal="clip">
    {shots.map((g, i) => (
      <label for={`${id}-r${i}`} class="kb-dev" style={`--j:${i}`}>
        <span class="kb-device-frame">
          <Image src={g.src} alt={g.alt} widths={[240, 360, 480]} sizes="(min-width: 60rem) 280px, 60vw" loading={i === 0 ? 'eager' : 'lazy'} class="block h-auto w-full" />
        </span>
      </label>
    ))}
  </div>

  <div class="kb-stage-meta">
    <ol class="kb-stage-tabs" role="list">
      {shots.map((g, i) => (
        <li><label for={`${id}-r${i}`} class="kb-stage-tab" style={`--j:${i}`}><span class="text-ink-3">{pad(i + 1)}</span> {g.caption}</label></li>
      ))}
    </ol>
    <div class="kb-stage-desc">
      {shots.map((g, i) => (
        <div class="kb-stage-d" style={`--j:${i}`}>
          <p class="kb-meta max-w-[46ch] text-ink-2" aria-hidden="true">{g.alt}</p>
          <button type="button" class="kb-btn mt-3" popovertarget={`${id}-p${i}`}>Enlarge</button>
        </div>
      ))}
    </div>
  </div>
  {source && <p class="kb-meta mt-4 text-ink-3">{source}</p>}
  {shots.map((g, i) => (
    <Lightbox id={`${id}-p${i}`} shot={g} index={i} total={n} prevId={`${id}-p${(i + n - 1) % n}`} nextId={`${id}-p${(i + 1) % n}`} />
  ))}
</section>
<style>
  .kb-stage { --sel: 0; --dw: clamp(190px, 56vw, 270px); position: relative; }
  .kb-stage:has(.kb-stage-r:nth-of-type(2):checked) { --sel: 1; }
  .kb-stage:has(.kb-stage-r:nth-of-type(3):checked) { --sel: 2; }
  .kb-stage:has(.kb-stage-r:nth-of-type(4):checked) { --sel: 3; }
  .kb-stage:has(.kb-stage-r:nth-of-type(5):checked) { --sel: 4; }
  .kb-stage:has(.kb-stage-r:nth-of-type(6):checked) { --sel: 5; }

  .kb-stage-view { position: relative; overflow: clip; height: calc(var(--dw) * 2.222 + 56px); background: var(--kb-raised); border: 1px solid var(--kb-rule); }
  .kb-dev {
    --o: calc(var(--j) - var(--sel));
    position: absolute; top: 28px; left: 50%; width: var(--dw); margin-left: calc(var(--dw) / -2); cursor: pointer;
    transform: translateX(calc(var(--o) * 64%)) scale(calc(1 - abs(var(--o)) * 0.1));
    opacity: calc(1 - abs(var(--o)) * 0.42);
    z-index: calc(10 - abs(var(--o)));
    transition: transform 620ms var(--kb-ease-mask), opacity 420ms var(--kb-ease-out);
  }
  .kb-device-frame { display: block; background: #000; border: 1px solid var(--kb-rule-2); border-radius: 26px; padding: 7px; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06), 0 24px 40px -24px rgb(0 0 0 / 0.8); overflow: clip; }
  .kb-device-frame img { border-radius: 19px; }
  /* Browsers without abs(): show the selected screen only. */
  @supports not (width: abs(1px)) {
    .kb-dev { transform: none; opacity: 0; z-index: 1; }
    .kb-stage:has(.kb-stage-r:nth-of-type(1):checked) .kb-dev[style*='--j:0'],
    .kb-stage:has(.kb-stage-r:nth-of-type(2):checked) .kb-dev[style*='--j:1'],
    .kb-stage:has(.kb-stage-r:nth-of-type(3):checked) .kb-dev[style*='--j:2'] { opacity: 1; }
  }
  .kb-stage-r:focus-visible ~ .kb-stage-view { outline: 2px solid var(--kb-ink); outline-offset: 4px; }

  .kb-stage-meta { display: grid; gap: 16px; margin-top: 16px; }
  @media (min-width: 48rem) { .kb-stage-meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--kb-gutter); } }
  .kb-stage-tabs { display: grid; list-style: none; padding: 0; margin: 0; border-bottom: 1px solid var(--kb-rule); }
  .kb-stage-tab { display: flex; gap: 10px; align-items: center; min-height: 44px; border-top: 1px solid var(--kb-rule); font-family: var(--font-mono); font-size: var(--text-meta); color: var(--kb-ink-2); cursor: pointer; transition: color var(--kb-dur-micro), padding-left var(--kb-dur-ui) var(--kb-ease-out); }
  @media (hover: hover) { .kb-stage-tab:hover { color: var(--kb-ink); } }
  .kb-stage:has(.kb-stage-r:nth-of-type(1):checked) .kb-stage-tab[style*='--j:0'],
  .kb-stage:has(.kb-stage-r:nth-of-type(2):checked) .kb-stage-tab[style*='--j:1'],
  .kb-stage:has(.kb-stage-r:nth-of-type(3):checked) .kb-stage-tab[style*='--j:2'],
  .kb-stage:has(.kb-stage-r:nth-of-type(4):checked) .kb-stage-tab[style*='--j:3'],
  .kb-stage:has(.kb-stage-r:nth-of-type(5):checked) .kb-stage-tab[style*='--j:4'],
  .kb-stage:has(.kb-stage-r:nth-of-type(6):checked) .kb-stage-tab[style*='--j:5'] { color: var(--kb-ink); padding-left: 12px; box-shadow: inset 2px 0 0 var(--kb-ink); }
  .kb-stage-r:focus-visible + .kb-stage-r, .kb-stage-r:focus-visible { outline: none; }

  /* Descriptions stack in one cell; the selected one is visible. */
  .kb-stage-desc { display: grid; align-content: start; }
  .kb-stage-d { grid-area: 1 / 1; visibility: hidden; opacity: 0; transition: opacity var(--kb-dur-micro) var(--kb-ease-out); }
  .kb-stage:has(.kb-stage-r:nth-of-type(1):checked) .kb-stage-d[style*='--j:0'],
  .kb-stage:has(.kb-stage-r:nth-of-type(2):checked) .kb-stage-d[style*='--j:1'],
  .kb-stage:has(.kb-stage-r:nth-of-type(3):checked) .kb-stage-d[style*='--j:2'],
  .kb-stage:has(.kb-stage-r:nth-of-type(4):checked) .kb-stage-d[style*='--j:3'],
  .kb-stage:has(.kb-stage-r:nth-of-type(5):checked) .kb-stage-d[style*='--j:4'],
  .kb-stage:has(.kb-stage-r:nth-of-type(6):checked) .kb-stage-d[style*='--j:5'] { visibility: visible; opacity: 1; }

  /* Keyboard focus: the radios are visually hidden, so mark the matching tab. */
  .kb-stage-r:nth-of-type(1):focus-visible ~ .kb-stage-meta .kb-stage-tab[style*='--j:0'],
  .kb-stage-r:nth-of-type(2):focus-visible ~ .kb-stage-meta .kb-stage-tab[style*='--j:1'],
  .kb-stage-r:nth-of-type(3):focus-visible ~ .kb-stage-meta .kb-stage-tab[style*='--j:2'],
  .kb-stage-r:nth-of-type(4):focus-visible ~ .kb-stage-meta .kb-stage-tab[style*='--j:3'],
  .kb-stage-r:nth-of-type(5):focus-visible ~ .kb-stage-meta .kb-stage-tab[style*='--j:4'],
  .kb-stage-r:nth-of-type(6):focus-visible ~ .kb-stage-meta .kb-stage-tab[style*='--j:5'] { outline: 2px solid var(--kb-ink); outline-offset: -2px; }
  @media (prefers-reduced-motion: reduce) { .kb-dev, .kb-stage-d, .kb-stage-tab { transition: none; } }
</style>
