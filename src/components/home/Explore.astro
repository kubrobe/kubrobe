---
/**
 * The second layer, in one place: compact cards that each open a detail window.
 * A card shows just enough to decide whether to open it; the window holds the rest.
 * The card heading carries the trigger, stretched over the card, so headings stay headings.
 */
import Section from '@/components/Section.astro';
import ModalTrigger from '@/components/modal/ModalTrigger.astro';
import { skills, categories } from '@/data/skills';
import { languages, languagesIntro } from '@/data/languages';
import { education } from '@/data/education';
import { interests } from '@/data/interests';
import { getCertifications, pad } from '@/lib/entries';

interface Props { number?: number; heading?: string; label?: string; id?: string }
const { number = 500, heading = 'Explore the *details*', label = 'Details', id = 'details' } = Astro.props;

const certs = await getCertifications();
const using = skills.filter((s) => s.status === 'using').length;
const areas = new Set(skills.map((s) => s.category)).size;
const edu = education[0];
const topSkills = skills.filter((s) => s.status === 'using').slice(0, 5).map((s) => s.name);

const cards = [
  {
    id: 'm-skills', code: 'KB—520', title: 'Skills', span: 'lg:col-span-6',
    text: 'What I use in real projects, and what I am still learning.',
    meta: `${pad(skills.length)} skills · ${areas} of ${categories.length} areas · ${using} in use`,
    chips: topSkills,
  },
  {
    id: 'm-languages', code: 'KB—510', title: languagesIntro.title, span: 'lg:col-span-4',
    text: languagesIntro.lede,
    meta: languages.length ? `${pad(languages.length)} profiles` : 'Studying several · profiles in progress',
  },
  {
    id: 'm-education', code: 'KB—530', title: 'Education', span: 'lg:col-span-3',
    text: edu ? `${edu.programme} at ${edu.institution}.` : 'Where and what I study.',
    meta: edu?.status === 'current' ? 'Current student' : 'Education',
  },
  {
    id: 'm-interests', code: 'KB—550', title: 'Interests', span: 'lg:col-span-4',
    text: 'What I keep coming back to, and where it shows up in my work.',
    meta: `${pad(interests.length)} interests`,
    chips: interests.slice(0, 6).map((i) => i.short ?? i.title),
  },
  {
    id: 'm-certifications', code: 'KB—540', title: 'Certifications', span: 'lg:col-span-3',
    text: 'View certifications, with issuers and verification links.',
    meta: certs.length ? `${pad(certs.length)} listed` : 'None listed yet',
  },
];
---
<Section number={number} label={label} id={id} heading={heading}>
  <ul class="kb-cards grid gap-[var(--kb-gutter)] md:grid-cols-6 lg:grid-cols-10">
    {cards.map((c, i) => (
      <li data-reveal class:list={['kb-card hr-host', i < 2 ? 'md:col-span-3' : 'md:col-span-2', c.span]} style={`--i:${i}`}>
        <p class="kb-meta flex items-center justify-between text-ink-3">
          <span>{c.code}</span>
          <span class="kb-card-plus" aria-hidden="true"><svg viewBox="0 0 12 12" width="12" height="12"><path d="M6 0 V12 M0 6 H12" stroke="currentColor" stroke-width="1.4" /></svg></span>
        </p>
        <h3 class="kb-card-title">
          <ModalTrigger target={c.id} class="kb-card-a" aria-describedby={`${c.id}-card-d`}>{c.title}</ModalTrigger>
        </h3>
        <p id={`${c.id}-card-d`} class="kb-card-text">{c.text}</p>
        {c.chips && c.chips.length > 0 && (
          <ul class="kb-card-chips" aria-hidden="true">{c.chips.map((t) => <li>{t}</li>)}</ul>
        )}
        <p class="kb-card-foot kb-meta"><span>{c.meta}</span><span class="kb-card-open">Open <span class="kb-arrow" data-dir="e">→</span></span></p>
      </li>
    ))}
  </ul>
</Section>
<style>
  .kb-cards { list-style: none; margin: 0; padding: 0; }
  .kb-card {
    position: relative; display: flex; flex-direction: column; gap: 14px; min-height: 220px; min-width: 0;
    padding: 18px 20px 16px; border: 1px solid var(--kb-rule); background: var(--kb-surface);
    transition: border-color var(--kb-dur-ui) var(--kb-ease-out), background-color var(--kb-dur-ui) var(--kb-ease-out), transform var(--kb-dur-ui) var(--kb-ease-out);
  }
  /* A jade corner appears on hover or focus: the selected-state language of the site. */
  .kb-card::before {
    content: ''; position: absolute; top: -1px; left: -1px; width: 28px; height: 28px; pointer-events: none;
    border-top: 2px solid var(--kb-jade); border-left: 2px solid var(--kb-jade);
    opacity: 0; transform: translate(4px, 4px); transition: opacity var(--kb-dur-micro) var(--kb-ease-out), transform var(--kb-dur-ui) var(--kb-ease-out);
  }
  .kb-card-title { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem); line-height: 1; font-weight: 560; letter-spacing: -0.035em; text-wrap: balance; }
  .kb-card-a { color: inherit; text-decoration: none; }
  .kb-card-a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .kb-card-a:focus-visible { outline: none; }
  .kb-card:has(.kb-card-a:focus-visible) { outline: 2px solid var(--kb-jade); outline-offset: 3px; }
  .kb-card-text { color: var(--kb-ink-2); max-width: 46ch; }
  .kb-card-chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .kb-card-chips li { font-family: var(--font-mono); font-size: 0.6875rem; padding: 3px 8px; border: 1px solid var(--kb-rule-2); color: var(--kb-ink-2); white-space: nowrap; }
  .kb-card-foot { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--kb-rule); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; color: var(--kb-ink-3); }
  .kb-card-open { color: var(--kb-ink); white-space: nowrap; }
  .kb-card-plus { display: inline-flex; transition: transform var(--kb-dur-ui) var(--kb-ease-mask), color var(--kb-dur-micro); }
  @media (hover: hover) {
    .kb-card:hover { border-color: var(--kb-rule-2); background: var(--kb-raised); }
    .kb-card:hover::before { opacity: 1; transform: none; }
    .kb-card:hover .kb-card-plus { transform: rotate(90deg); color: var(--kb-jade); }
    .kb-card:hover .kb-arrow { transform: translateX(4px); }
  }
  .kb-card:has(.kb-card-a:focus-visible)::before { opacity: 1; transform: none; }
  .kb-card:has(.kb-card-a:focus-visible) .kb-card-plus { transform: rotate(90deg); color: var(--kb-jade); }
  .kb-card:active { transform: scale(0.995); }
  @media (prefers-reduced-motion: reduce) { .kb-card, .kb-card::before, .kb-card-plus { transition: none; } }
</style>
