---
import Modal from '@/components/modal/Modal.astro';
import { education, educationIntro } from '@/data/education';
---
<Modal id="m-education" title={educationIntro.title} eyebrow="KB—530 · Education" lede={educationIntro.lede}>
  {education.map((e, ei) => {
    const facts = [
      ['Programme', e.programme],
      ['Major', e.major],
      ['Degree', e.degree],
      ['Period', e.period],
      ['Location', e.location],
      ['Status', e.status === 'current' ? 'Current student' : 'Completed'],
    ].filter((f): f is [string, string] => Boolean(f[1]));
    return (
      <article class="grid gap-8" aria-labelledby={`edu-${ei}`}>
        <div class="kb-edu-card grid gap-6 border border-rule p-5 sm:p-7" data-m style="--i:1">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="kb-label mb-2">Institution</p>
              <h3 id={`edu-${ei}`} class="text-[clamp(1.6rem,1.2rem+1.8vw,2.5rem)] leading-[1.02] font-[560] tracking-[-0.035em]">{e.institution}</h3>
            </div>
            {e.status === 'current' && <span class="kb-m-tag flex-none" data-tone="jade">Now</span>}
          </div>
          <dl class="kb-m-dl">{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
          {e.summary && <p class="kb-serif text-[1.45rem] leading-[1.25] text-ink-2">{e.summary}</p>}
        </div>
        {e.coursework.length > 0 && (
          <section data-m style="--i:2">
            <h4 class="kb-m-h">Relevant coursework</h4>
            <ul class="kb-m-grid" data-cols="2">{e.coursework.map((c) => (
              <li class="kb-m-cell grid gap-1.5">
                <span class="text-lg font-[540]">{c.name}</span>
                {c.note && <span class="text-sm text-ink-2">{c.note}</span>}
                {c.project && <a href={`#m-project-${c.project}`} data-modal-open={`m-project-${c.project}`} class="kb-m-link kb-meta w-fit">Open project →</a>}
              </li>
            ))}</ul>
          </section>
        )}
        {e.projects.length > 0 && (
          <section data-m style="--i:3">
            <h4 class="kb-m-h">Academic projects</h4>
            <ul class="grid gap-3">{e.projects.map((p) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-rule pt-3">
                <span><span class="font-[540]">{p.name}</span>{p.note && <span class="text-ink-2"> · {p.note}</span>}</span>
                {p.project && <a href={`#m-project-${p.project}`} data-modal-open={`m-project-${p.project}`} class="kb-m-link kb-meta">Explore →</a>}
              </li>
            ))}</ul>
          </section>
        )}
        {e.international && <section data-m style="--i:4"><h4 class="kb-m-h">International study</h4><p>{e.international}</p></section>}
      </article>
    );
  })}
</Modal>
