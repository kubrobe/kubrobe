---
import Wordmark from '@/components/Wordmark.astro';
import { profile } from '@/data/profile';
import { code, isoDate, pad } from '@/lib/entries';
import pkg from '../../../package.json';

interface Props { entries: number; updated?: Date | undefined; next?: string | undefined }
const { entries, updated, next } = Astro.props;
const clock = profile.showLocalTime && profile.timeZone ? profile.timeZone : undefined;
---
<section class="kb-hero kb-wrap flex flex-col pt-5 pb-8 lg:pt-8 lg:pb-12" aria-label="Introduction">
  <div class="kb-grid kb-meta text-ink-2">
    <div class="kb-rail hidden lg:block"><span class="block text-ink">{code(0)}</span>Index</div>
    <p class="kb-main flex flex-wrap justify-between gap-x-6 gap-y-1 border-t border-rule pt-2">
      {profile.city && (
        <span>{profile.city}{clock && <> · <time data-clock={clock}>--:--</time> local</>}</span>
      )}
      {entries > 0 && <span>Entries {pad(entries, 3)}</span>}
      {updated && <span>Updated <time datetime={isoDate(updated)}>{isoDate(updated)}</time></span>}
      <span>v{pkg.version}</span>
    </p>
  </div>

  <div class="mt-auto pt-[clamp(96px,30vw,160px)] lg:pt-24">
    <Wordmark />
  </div>

  <div class="kb-grid kb-meta mt-6 items-baseline text-ink-2 lg:mt-8">
    <p class="kb-rail hidden lg:block">{code(0)}</p>
    <p class="col-span-2 md:col-span-4 lg:col-[3/9]">An index of work, writing and credentials.</p>
    {next && (
      <a href={next} class="kb-draw col-span-2 justify-self-end whitespace-nowrap text-ink md:col-span-2 lg:col-[11/13]">
        Enter the index <span aria-hidden="true">↓</span>
      </a>
    )}
  </div>
</section>
<style>
  /* The hero fills the first screen so the wordmark lands on the fold. */
  @media (min-width: 48rem) and (min-height: 521px) {
    .kb-hero { min-height: calc(100svh - var(--kb-bar-h) - var(--kb-mobile-bar-h) - env(safe-area-inset-top)); }
  }
</style>
{clock && (
  <script>
    document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((el) => {
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: el.dataset['clock'] });
      const tick = () => { el.textContent = fmt.format(new Date()); };
      tick();
      setInterval(tick, 30_000);
    });
  </script>
)}
