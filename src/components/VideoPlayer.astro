---
import { getVideo } from '@/data/media';
import { showPlaceholders } from '@/data/profile';
interface Props { video: string; id?: string; label?: string; number?: string }
const { video, id = 'video', label = 'From idea to presentation' } = Astro.props;
const v = getVideo(video);
const src = v?.source;
// Real media: render. No media: hidden on the live site; a marked stand-in only in dev and design-review builds.
const preview = !src && Boolean(v) && (import.meta.env.DEV || showPlaceholders);
const link = src ? (src.kind === 'mp4' ? src.src : src.watch) : '#';
const kind = src?.kind;
---
{v && (src || preview) && (
  <section class="kb-wrap pb-12 lg:pb-20" aria-labelledby={`${id}-h`}>
    <div class="kb-grid"><div class="kb-main">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 id={`${id}-h`} class="kb-label">{label}</h2>
        <p class="kb-meta text-ink-3">{v.cfg.duration}{src?.kind === 'youtube' || src?.kind === 'vimeo' ? ` · opens ${src.kind === 'youtube' ? 'YouTube' : 'Vimeo'} on play` : ''}</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-12 lg:gap-x-[var(--kb-gutter)]">
        <div class="lg:col-span-4">
          <p class="text-h3 font-medium leading-tight tracking-[-0.025em]">{v.cfg.title}</p>
          <p class="mt-3 max-w-[40ch] text-ink-2">{v.cfg.description}</p>
        </div>
        <figure class="lg:col-span-8" data-reveal="clip">
          {src ? (
            <div class="kb-vp" data-vp data-kind={kind} data-id={src.kind === 'mp4' ? undefined : src.id} data-src={src.kind === 'mp4' ? src.src : undefined} data-title={v.cfg.title} data-captions={v.cfg.captions} data-poster={v.cfg.poster}>
              <a href={link} class="kb-vp-face" aria-label={`Play video: ${v.cfg.title}, ${v.cfg.duration}`} rel="noopener">
                {v.cfg.poster && <img src={v.cfg.poster} alt="" width="1280" height="720" loading="lazy" decoding="async" class="kb-vp-img" />}
                <span class="kb-vp-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
                <span class="kb-vp-label kb-meta" aria-hidden="true">Play · {v.cfg.duration}</span>
              </a>
            </div>
          ) : (
            <div class="kb-vp kb-vp-stub">
              <span class="kb-ph-tag">Not configured</span>
              <p class="kb-meta mt-3 max-w-[44ch] text-center text-ink-2">No video URL is set, so this section is hidden on the live site. Add the URL to <code>src/data/media.ts</code> (field <code>url</code>).</p>
            </div>
          )}
          <figcaption class="kb-meta mt-3 max-w-[60ch] text-ink-3">{v.cfg.caption}</figcaption>
          {v.cfg.transcript && v.cfg.transcript.length > 0 && (
            <details class="kb-vp-tr">
              <summary class="kb-meta">Transcript</summary>
              <div class="kb-vp-tr-b">{v.cfg.transcript.map((t) => <p>{t}</p>)}</div>
            </details>
          )}
          {src && v.cfg.chapters && v.cfg.chapters.length > 0 && (
            <ol class="kb-vp-chapters" role="list" aria-label="Chapters" data-chapters>
              {v.cfg.chapters.map((c, i) => (
                <li><button type="button" class="kb-vp-ch" data-t={c.t}><span class="text-ink-3">{String(i + 1).padStart(2, '0')}</span> <span class="kb-vp-ch-t">{c.label}{c.note && <span class="kb-vp-ch-n">{c.note}</span>}</span> <span class="text-ink-3">{Math.floor(c.t / 60)}:{String(c.t % 60).padStart(2, '0')}</span></button></li>
              ))}
            </ol>
          )}
        </figure>
      </div>
    </div></div>
  </section>
)}
<script>
  // Nothing from a video provider loads until the visitor asks for it. No autoplay on arrival.
  document.querySelectorAll<HTMLElement>('[data-vp]').forEach((box) => {
    const wrap = box.closest('figure');
    const load = (start: number) => {
      const { kind, id, src, title = 'Video', captions, poster } = box.dataset;
      let el = box.querySelector<HTMLElement>('.kb-vp-media');
      if (el instanceof HTMLVideoElement) { el.currentTime = start; void el.play().catch(() => {}); el.focus(); return; }
      if (el instanceof HTMLIFrameElement) {
        el.src = kind === 'vimeo'
          ? `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1#t=${start}s`
          : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&start=${start}`;
        el.focus(); return;
      }
      if (kind === 'mp4' && src) {
        const v = document.createElement('video');
        v.src = src; v.controls = true; v.playsInline = true; v.preload = 'metadata'; if (poster) v.poster = poster;
        v.setAttribute('aria-label', title);
        if (captions) { const t = document.createElement('track'); t.kind = 'captions'; t.src = captions; t.srclang = 'en'; t.label = 'English'; t.default = true; v.append(t); }
        v.addEventListener('loadedmetadata', () => { if (start) v.currentTime = start; void v.play().catch(() => {}); }, { once: true });
        el = v;
      } else {
        const f = document.createElement('iframe');
        f.src = kind === 'vimeo'
          ? `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1#t=${start}s`
          : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&start=${start}`;
        f.title = title; f.allow = 'autoplay; fullscreen; picture-in-picture'; f.allowFullscreen = true; f.referrerPolicy = 'strict-origin-when-cross-origin';
        el = f;
      }
      el.className = 'kb-vp-media';
      box.querySelector('.kb-vp-face')?.replaceWith(el);
      el.focus();
    };
    box.querySelector<HTMLAnchorElement>('.kb-vp-face')?.addEventListener('click', (e) => { e.preventDefault(); load(0); });
    wrap?.querySelectorAll<HTMLButtonElement>('.kb-vp-ch').forEach((b) => b.addEventListener('click', () => load(Number(b.dataset['t'] ?? 0))));
  });
</script>
<style is:global>
  .kb-vp { position: relative; aspect-ratio: 16 / 9; width: 100%; background: #000; border: 1px solid var(--kb-rule-2); overflow: hidden; }
  .kb-vp-media { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #000; }
  .kb-vp-face {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 14px; text-decoration: none; color: #f2f1ee;
    background: radial-gradient(120% 90% at 50% 40%, #1b1b1b, #0a0a0a) center / cover no-repeat;
  }
  .kb-vp-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .kb-vp-face::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / .55), rgb(0 0 0 / 0) 55%); pointer-events: none; }
  .kb-vp-play, .kb-vp-label { position: relative; z-index: 1; }
  .kb-vp-ch-t { display: grid; gap: 2px; }
  .kb-vp-ch-n { color: var(--kb-ink-3); }
  .kb-vp-tr { margin-top: 16px; border-top: 1px solid var(--kb-rule); border-bottom: 1px solid var(--kb-rule); }
  .kb-vp-tr > summary { display: flex; min-height: 44px; align-items: center; cursor: pointer; color: var(--kb-ink-2); list-style: none; }
  .kb-vp-tr > summary:focus-visible { outline: 2px solid var(--kb-ink); outline-offset: -2px; }
  .kb-vp-tr-b { display: grid; gap: 12px; max-width: 62ch; padding: 4px 0 20px; color: var(--kb-ink-2); }
  .kb-vp-play { display: grid; place-items: center; width: 72px; height: 72px; border: 1px solid rgb(255 255 255 / .5); border-radius: 50%; transition: transform var(--kb-dur-ui) var(--kb-ease-out), background-color var(--kb-dur-micro) var(--kb-ease-out), color var(--kb-dur-micro) var(--kb-ease-out); }
  .kb-vp-play svg { margin-left: 3px; }
  .kb-vp-label { color: #cfcdc8; }
  @media (hover: hover) { .kb-vp-face:hover .kb-vp-play { background: #f2f1ee; color: #0a0a0a; transform: scale(1.06); } }
  .kb-vp-face:focus-visible { outline: 2px solid #f2f1ee; outline-offset: -6px; }
  .kb-vp-face:focus-visible .kb-vp-play { background: #f2f1ee; color: #0a0a0a; }
  .kb-vp-stub { display: grid; place-content: center; justify-items: center; background: transparent; border-style: dashed; padding: 16px; }
  .kb-vp-chapters { display: grid; gap: 0; margin: 16px 0 0; padding: 0; list-style: none; border-bottom: 1px solid var(--kb-rule); }
  @media (min-width: 48rem) { .kb-vp-chapters { grid-template-columns: 1fr 1fr; column-gap: var(--kb-gutter); } }
  .kb-vp-ch { display: flex; width: 100%; min-height: 44px; align-items: center; gap: 10px; border: 0; border-top: 1px solid var(--kb-rule); background: transparent; color: var(--kb-ink-2); text-align: left; font: inherit; font-family: var(--font-mono); font-size: var(--text-meta); cursor: pointer; transition: color var(--kb-dur-micro) var(--kb-ease-out), padding-left var(--kb-dur-ui) var(--kb-ease-out); }
  .kb-vp-ch > span:last-child { margin-left: auto; }
  @media (hover: hover) { .kb-vp-ch:hover { color: var(--kb-ink); padding-left: 8px; } }
  .kb-vp-ch:focus-visible { color: var(--kb-ink); outline: 2px solid var(--kb-ink); outline-offset: -2px; }
  @media (prefers-reduced-motion: reduce) { .kb-vp-ch, .kb-vp-play { transition: none; } }
</style>
