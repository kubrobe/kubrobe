---
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/Section.astro';
import StatusGlyph from '@/components/StatusGlyph.astro';
import { Image } from 'astro:assets';
import { workTypeLabel, pad } from '@/lib/entries';
interface Props { featured: CollectionEntry<'work'>[]; total: number }
const { featured, total } = Astro.props;
---
<Section marker="03" label="Selected work" id="work" heading="Selected *work*">
  <!--
    A text index, not a gallery: the screens live on each case study. The whole row is one link.
    Everything that matters (type, year, status) is visible without hover.
  -->
  <ol class="kb-ix">
    {featured.map((w, i) => {
      const d = w.data;
      return (
        <li data-reveal class="kb-ix-li border-t border-rule last:border-b">
          <a href={`/work/${w.id}/`} class="kb-ix-a group" aria-describedby={`kb-ix-${d.number}-d`}>
            <span class="kb-ix-n kb-meta">{pad(i + 1)}</span>
            <span class="kb-ix-title-wrap">
              <span data-reveal="mask" class="block">
                <span class="kb-ix-title" style={`view-transition-name:kb-t-${d.number};view-transition-class:kb-title`}>{d.title}</span>
              </span>
              {d.placeholder && <span class="kb-ph-tag ml-2 align-middle">Placeholder</span>}
              <span id={`kb-ix-${d.number}-d`} class="kb-ix-sum">{d.summary}</span>
            </span>
            <span class="kb-ix-meta kb-meta">
              <span>{workTypeLabel[d.type]} · {d.year}</span>
              <StatusGlyph kind="work" status={d.status} />
            </span>
            {d.gallery.length > 0 && (
              <span class="kb-ix-sheet" aria-hidden="true">
                {d.gallery.slice(0, 3).map((g, j) => (
                  <span class="kb-ix-shot" style={`--j:${j}`}>
                    <Image src={g.src} alt="" width={180} widths={[120, 180, 270]} sizes="(min-width: 60rem) 5.5rem, 30vw" loading="lazy" decoding="async" />
                  </span>
                ))}
              </span>
            )}
            <span class="kb-arrow kb-ix-arrow" data-dir="e" aria-hidden="true">→</span>
          </a>
        </li>
      );
    })}
  </ol>
  {total > featured.length && (
    <a href="/work/" class="kb-draw kb-meta mt-8 inline-flex min-h-11 items-center text-ink-2 hover:text-ink">All {pad(total)} entries →</a>
  )}
</Section>
<style>
  .kb-ix { margin: 0; padding: 0; list-style: none; }
  .kb-ix-a {
    position: relative; display: grid; gap: 6px 16px; align-items: start; text-decoration: none; color: inherit;
    grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'n meta arrow' 'title title title' 'sheet sheet sheet';
    padding: 20px 0 24px;
    /* A faint fill rises from the bottom edge on hover or focus. */
    background: linear-gradient(var(--kb-raised), var(--kb-raised)) no-repeat 0 100% / 100% 0;
    transition: background-size var(--kb-dur-ui) var(--kb-ease-out);
  }
  .kb-ix-n { grid-area: n; color: var(--kb-ink); }
  .kb-ix-meta { grid-area: meta; justify-self: end; display: flex; flex-wrap: wrap; gap: 4px 14px; justify-content: flex-end; color: var(--kb-ink-2); transition: color var(--kb-dur-micro) var(--kb-ease-out); }
  .kb-ix-arrow { grid-area: arrow; font-family: var(--font-mono); color: var(--kb-ink-2); }
  .kb-ix-title-wrap { grid-area: title; display: grid; gap: 14px; min-width: 0; }
  .kb-ix-title {
    display: inline-block; font-size: clamp(2.5rem, 1.3rem + 5.2vw, 5.5rem); line-height: 0.96; font-weight: 560; letter-spacing: -0.045em;
    /* Underline sweeps beneath the name. */
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 2px; padding-bottom: 0.08em;
    transition: transform var(--kb-dur-ui) var(--kb-ease-out), background-size var(--kb-dur-ui) var(--kb-ease-mask);
  }
  /* Contact sheet: three real screens, cropped from the top, as a quiet preview of the case study. */
  .kb-ix-sheet { grid-area: sheet; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 10px; max-width: 26rem; }
  .kb-ix-shot { display: block; aspect-ratio: 3 / 4; overflow: clip; background: var(--kb-raised); border: 1px solid var(--kb-rule); }
  .kb-ix-shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: 0.82; transition: opacity var(--kb-dur-ui) var(--kb-ease-out), transform var(--kb-dur-ui) var(--kb-ease-out); transition-delay: calc(var(--j) * 40ms); }
  .kb-ix-sum { max-width: 44ch; font-size: 1.125rem; line-height: 1.5; color: var(--kb-ink-2); }
  .kb-ix-a:focus-visible { outline: 2px solid var(--kb-jade); outline-offset: 4px; }

  @media (min-width: 60rem) {
    .kb-ix-a {
      grid-template-columns: 3.5rem minmax(0, 1fr) 11rem 17.5rem 2.5rem; grid-template-areas: 'n title meta sheet arrow'; padding: 36px 14px 40px; margin-inline: -14px; align-items: start;
    }
    .kb-ix-sheet { margin-top: 0; max-width: none; padding-top: 0.4rem; }
    .kb-ix-n { padding-top: 1.1rem; }
    .kb-ix-meta { flex-direction: column; align-items: flex-end; padding-top: 1.1rem; gap: 6px; }
    .kb-ix-arrow { padding-top: 1rem; justify-self: end; font-size: 1.25rem; }
  }
  @media (hover: hover) {
    .kb-ix-a:hover { background-size: 100% 100%; }
    .kb-ix-a:hover .kb-ix-title { transform: translateX(14px); background-size: 100% 2px; }
    .kb-ix-a:hover .kb-ix-meta { color: var(--kb-ink); }
    .kb-ix-a:hover .kb-ix-shot img { opacity: 1; transform: scale(1.04); }
  }
  .kb-ix-a:focus-visible .kb-ix-shot img { opacity: 1; transform: scale(1.04); }
  .kb-ix-a:focus-visible { background-size: 100% 100%; }
  .kb-ix-a:focus-visible .kb-ix-title { transform: translateX(14px); background-size: 100% 2px; }
  .kb-ix-a:focus-visible .kb-ix-meta { color: var(--kb-ink); }
  .kb-ix-a:active { background-size: 100% 100%; }
  @media (prefers-reduced-motion: reduce) { .kb-ix-a, .kb-ix-title, .kb-ix-shot img { transition: none; } }
</style>
