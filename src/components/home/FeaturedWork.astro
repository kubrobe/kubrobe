---
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/Section.astro';
import EntryHead from '@/components/EntryHead.astro';
import EntryFigure from '@/components/EntryFigure.astro';
import StatusGlyph from '@/components/StatusGlyph.astro';
import { workTypeLabel, pad, code } from '@/lib/entries';
interface Props { featured: CollectionEntry<'work'>[]; total: number }
const { featured, total } = Astro.props;
---
<Section number={100} label="Selected work" id="work" heading="Selected *work*">
  <EntryHead />
  <ol>
    {featured.map((w) => {
      const d = w.data;
      return (
        <li data-reveal id={`kb-${d.number}`} class="kb-proj relative border-t border-rule last:border-b">
          <a href={`/work/${w.id}/`} class="kb-proj-link group grid grid-cols-[5.5rem_minmax(0,1fr)] gap-x-4 gap-y-2 py-5 no-underline md:grid-cols-[8rem_minmax(0,1fr)] lg:grid-cols-[7rem_minmax(0,1fr)_9rem_4rem_9rem] lg:items-baseline lg:py-7">
            <span class="kb-meta hidden text-ink-3 transition-colors group-hover:text-ink group-focus-visible:text-ink lg:inline">{code(d.number)}</span>
            <span class="row-span-2 lg:hidden"><EntryFigure number={d.number} class="w-full" /></span>
            <span class="grid min-w-0 content-start gap-1.5">
              <span class="kb-meta text-ink-3 lg:hidden">{code(d.number)} · {workTypeLabel[d.type]} · {d.year}</span>
              <span class="kb-proj-title text-h3 leading-[1.08] font-medium tracking-[-0.025em]">
                {d.title}{d.placeholder && <span class="kb-ph-tag ml-2 align-middle">Placeholder</span>}
              </span>
              <span class="line-clamp-2 max-w-[52ch] text-sm text-ink-2 lg:text-body">{d.summary}</span>
            </span>
            <span class="kb-meta hidden text-ink-2 lg:inline">{workTypeLabel[d.type]}</span>
            <span class="kb-meta hidden text-ink-2 lg:inline">{d.year}</span>
            <span class="col-start-2 lg:col-start-auto"><StatusGlyph kind="work" status={d.status} /></span>
          </a>
          <!-- Desktop: the same generated figure, revealed through a mask on hover or keyboard focus. CSS only. -->
          <figure class="kb-proj-fig pointer-events-none absolute top-1/2 right-[26rem] z-10 hidden w-[min(20%,240px)] lg:block" aria-hidden="true">
            <EntryFigure number={d.number} class="w-full" />
            <figcaption class="kb-meta mt-2 text-ink-2">Fig. {code(d.number)} · generated</figcaption>
          </figure>
        </li>
      );
    })}
  </ol>
  <a href="/work/" class="kb-draw kb-meta mt-8 inline-block text-ink-2 hover:text-ink">All {pad(total)} entries →</a>
</Section>
<style>
  .kb-proj-title { display: inline-block; transition: transform var(--kb-dur-ui) var(--kb-ease-out); }
  .kb-proj-link:focus-visible { outline-offset: -2px; }
  .kb-proj-fig {
    opacity: 0;
    translate: 0 -50%;
    clip-path: inset(0 0 100% 0);
    transition: opacity var(--kb-dur-micro), clip-path var(--kb-dur-ui) var(--kb-ease-mask);
  }
  @media (hover: hover) {
    .kb-proj-link:hover .kb-proj-title { transform: translateX(16px); }
    .kb-proj:has(.kb-proj-link:hover) .kb-proj-fig { opacity: 1; clip-path: inset(0 0 0 0); }
  }
  .kb-proj-link:focus-visible .kb-proj-title { transform: translateX(16px); }
  .kb-proj:has(.kb-proj-link:focus-visible) .kb-proj-fig { opacity: 1; clip-path: inset(0 0 0 0); }
  @media (prefers-reduced-motion: reduce) { .kb-proj-fig { transition: none; } }
</style>
