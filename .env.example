# Optional. Defaults to https://kubrobe.uz. Only set it to override the canonical origin (no trailing slash).
SITE_URL=
# Set to true to render the clearly marked placeholder entries (design review only).
KB_SHOW_PLACEHOLDERS=false
# Optional. Telegram username without @; overrides TELEGRAM_USERNAME in src/data/contact.ts. Leave empty until it exists.
PUBLIC_TELEGRAM_USERNAME=
