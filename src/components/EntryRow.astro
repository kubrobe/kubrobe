---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StatusGlyph from './StatusGlyph.astro';
import { code, type Kind, type Status } from '@/lib/entries';
interface Props {
  href: string;
  number: number;
  title: string;
  kind: Kind;
  status: Status;
  type?: string | undefined;
  year?: string | number | undefined;
  placeholder?: boolean;
  /** Decorative screen shown beside the row on hover (desktop pointer only). */
  preview?: ImageMetadata | undefined;
}
const { href, number, title, kind, status, type, year, placeholder = false, preview } = Astro.props;
---
<li data-reveal id={`kb-${number}`} class="kb-li relative border-t border-rule last:border-b">
  <a href={href} data-entry-row data-number={number} data-code={code(number)} class="kb-row group grid grid-cols-[auto_minmax(0,1fr)_auto] items-baseline gap-x-4 gap-y-1 py-4 no-underline lg:grid-cols-[7rem_minmax(0,1fr)_9rem_4rem_9rem] lg:py-6">
    <span class="kb-meta text-ink-3 transition-colors group-hover:text-ink group-focus-visible:text-ink">{code(number)}</span>
    <span class="kb-row-title min-w-0 text-h3 font-medium leading-tight tracking-[-0.025em]" style={kind === 'work' ? `view-transition-name:kb-t-${number};view-transition-class:kb-title` : undefined}>
      {title}{placeholder && <span class="kb-ph-tag ml-2 align-middle">Placeholder</span>}
    </span>
    <span class="kb-meta col-start-2 text-ink-2 lg:hidden">{[type, year].filter(Boolean).join(' · ')}</span>
    <span class="kb-meta hidden text-ink-2 lg:inline">{type}</span>
    <span class="kb-meta hidden text-ink-2 lg:inline">{year}</span>
    <span class="col-start-3 row-start-1 justify-self-end lg:col-start-auto lg:row-start-auto lg:justify-self-start"><StatusGlyph kind={kind} status={status} compact /></span>
  </a>
  {preview && (
    <span class="kb-peek" aria-hidden="true"><Image src={preview} alt="" widths={[160, 320]} sizes="160px" loading="lazy" class="block h-full w-auto" /></span>
  )}
</li>
<style>
  .kb-row-title { display: inline-block; transition: transform var(--kb-dur-ui) var(--kb-ease-out); }
  @media (hover: hover) {
    .kb-row:hover .kb-row-title { transform: translateX(16px); }
  }
  /* A screen from the project slides in beside the row: pointer-only, decorative, pinned in place (no cursor chasing). */
  .kb-peek { display: none; }
  @media (hover: hover) and (min-width: 60rem) {
    .kb-peek { display: block; position: absolute; z-index: 2; left: 55%; top: 50%; height: 200px; translate: 0 -50%; pointer-events: none; border: 1px solid var(--kb-rule-2); background: var(--kb-raised); opacity: 0; clip-path: inset(0 0 100% 0); transition: opacity var(--kb-dur-micro) var(--kb-ease-out), clip-path var(--kb-dur-ui) var(--kb-ease-mask); }
    .kb-li:has(.kb-row:hover) .kb-peek, .kb-li:has(.kb-row:focus-visible) .kb-peek { opacity: 1; clip-path: inset(0); }
  }
  @media (prefers-reduced-motion: reduce) { .kb-peek { transition: none !important; clip-path: none !important; } }
  .kb-row:focus-visible { outline-offset: -2px; }
  .kb-row:focus-visible .kb-row-title { transform: translateX(16px); }
</style>
