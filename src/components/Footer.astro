---
import ContactBlock from './ContactBlock.astro';
import { contact } from '@/data/site';
import { profile } from '@/data/profile';
import { getNav } from '@/lib/nav';
import pkg from '../../package.json';
const sha = import.meta.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7);
// The contact page carries the full block itself; every other page closes with it.
const onContact = /^\/contact\/?$/.test(Astro.url.pathname);
const showContact = contact.channels.length > 0 && !onContact;
const nav = await getNav();
const year = new Date().getFullYear();
---
<footer id="contact" class="kb-foot kb-wrap border-t border-rule pb-6 lg:pb-8" aria-labelledby={showContact ? 'contact-h' : undefined} aria-label={showContact ? undefined : 'Site footer'}>
  {showContact && (
    <div class="pt-[clamp(56px,9vw,128px)] pb-[clamp(48px,7vw,104px)]">
      <ContactBlock />
    </div>
  )}
  <div class="kb-colophon kb-meta border-t border-rule pt-4 text-ink-2">
    <p class="text-ink">© {year} {profile.name}</p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5">
        {nav.map((n) => <li><a class="kb-draw inline-flex min-h-11 items-center" href={n.href}>{n.label}</a></li>)}
        <li><a class="kb-draw inline-flex min-h-11 items-center" href="#main">Top <span aria-hidden="true" class="kb-arrow ml-1" data-dir="n">↑</span></a></li>
      </ul>
    </nav>
    <p class="text-ink-3">{profile.brand} v{pkg.version}{sha && <> · {sha}</>} · Geist, Geist Mono, Instrument Serif · Astro</p>
  </div>
</footer>
<style>
  .kb-colophon { display: grid; gap: 4px 24px; align-items: center; }
  @media (min-width: 48rem) { .kb-colophon { grid-template-columns: auto auto minmax(0, 1fr); } .kb-colophon > :last-child { justify-self: end; text-align: right; } }
</style>
