---
import Facts from '@/components/profile/Facts.astro';
import { profile } from '@/data/profile';
/** Who is behind KUBROBE: the approved introduction beside the identity card. */
---
<section id="about" class="kb-wrap kb-section kb-rule" aria-labelledby="intro-h">
  <div class="kb-grid gap-y-10">
    <div class="kb-rail kb-meta flex gap-3 text-ink-2 lg:sticky lg:top-[calc(var(--kb-bar-h)+28px)] lg:block lg:self-start lg:pt-3">
      <span class="text-ink lg:block">02</span><span>Introduction</span>
    </div>
    <h2 id="intro-h" class="sr-only">Introduction</h2>
    <p data-reveal class="kb-serif min-w-0 text-[clamp(1.875rem,1.25rem+2.7vw,3.75rem)] leading-[1.06] tracking-[-0.015em] text-pretty md:col-span-6 lg:col-[3/10]">{profile.intro}</p>
    <div class="grid content-start gap-6 md:col-span-4 lg:col-[3/8]">
      <Facts />
      <a href="/about/" class="kb-btn kb-btn--line w-fit gap-3" data-reveal>More about me <span class="kb-arrow" data-dir="e" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
