---
import type { NavItem } from '@/lib/nav';
interface Props { nav: NavItem[] }
const { nav } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href) || path === href.replace(/\/$/, '');
---
{nav.length > 0 && (
  <nav aria-label="Primary" style="view-transition-name: kb-mobile-bar" class="kb-mobile-bar fixed inset-x-0 bottom-0 z-50 border-t border-rule bg-surface pb-[env(safe-area-inset-bottom)] lg:hidden">
    <ul class="kb-wrap grid h-14 items-stretch" style={`grid-template-columns:repeat(${nav.length},minmax(0,1fr))`}>
      {nav.map((n) => (
        <li class="flex">
          <a
            href={n.href}
            class:list={['kb-meta relative flex min-h-11 flex-1 items-center justify-center no-underline transition-colors active:bg-raised', isActive(n.href) ? 'text-surface' : 'text-ink-2']}
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {isActive(n.href) && <span class="kb-nav-ind-m absolute inset-1 bg-jade" aria-hidden="true" />}
            <span class="relative">{n.short ?? n.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
<style>
  /* The active block slides between items across page loads (cross-document view transition). */
  .kb-nav-ind-m { view-transition-name: kb-nav-ind-m; }
</style>
